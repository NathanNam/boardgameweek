---
import Base from '../../layouts/Base.astro';
import IssueView from '../../components/IssueView.astro';
import { getIssues, issuePath, ogPath, issueLine, type Issue } from '../../lib/issues';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
  const issues = await getIssues();
  return issues.map((issue) => ({ params: { slug: issue.id }, props: { issue, issues } }));
}

interface Props { issue: Issue; issues: Issue[] }
const { issue, issues } = Astro.props;
const d = issue.data;
const isLatest = issues[0]?.id === issue.id;
// Shelf: this week plus the weeks around it.
const at = issues.findIndex((i) => i.id === issue.id);
const shelf = issues.slice(Math.max(0, at - 1), Math.max(0, at - 1) + 3);
---
<Base
  title={`Issue No. ${d.issue}: ${d.family.name}${d.solo ? ` and ${d.solo.name}` : ''} · ${SITE.name}`}
  description={`${issueLine(issue)}. ${d.theme}: ${d.dek}`}
  canonical={issuePath(issue)}
  ogImage={ogPath(issue)}
  ogAlt={`${SITE.name}, Issue No. ${d.issue}: ${d.theme}. ${d.family.name}${d.solo ? ` and ${d.solo.name}` : ''}.`}
  ogType="article"
  nav={isLatest ? 'week' : 'archive'}
  mastLine={[`Issue No. ${d.issue}`, d.label]}
>
  <IssueView issue={issue} shelf={shelf} />
</Base>
