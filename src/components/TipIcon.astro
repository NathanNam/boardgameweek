---
interface Props { icon: string; i: number }
const { icon, i } = Astro.props;
const bg = ['var(--mustard)', 'var(--orange)', 'var(--mustard-lt)'][i % 3];
const paths: Record<string, string> = {
  announcer: '<path d="M4 9v6h4l5 4V5L8 9z" fill="#2a1f16"/><path d="M16 8c1.5 1.2 1.5 6.8 0 8M19 5c3 3 3 11 0 14" stroke="#2a1f16" stroke-width="2" fill="none" stroke-linecap="round"/>',
  pair: '<circle cx="8" cy="8" r="3.5" fill="#2a1f16"/><circle cx="16.5" cy="10" r="2.5" fill="#2a1f16"/><path d="M2 20c0-4 3-7 6-7s6 3 6 7zM12.5 20c0-3 2-6 4-6s5 3 5 6z" fill="#2a1f16"/>',
  timer: '<circle cx="12" cy="13" r="8" fill="none" stroke="#2a1f16" stroke-width="2.4"/><path d="M12 13V8M9 2h6" stroke="#2a1f16" stroke-width="2.4" stroke-linecap="round"/>',
  eye: '<path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z" fill="none" stroke="#2a1f16" stroke-width="2.2"/><circle cx="12" cy="12" r="3.5" fill="#2a1f16"/>',
  hand: '<path d="M7 12V5.5a1.5 1.5 0 0 1 3 0V11V4a1.5 1.5 0 0 1 3 0v7V5a1.5 1.5 0 0 1 3 0v7.5V8a1.5 1.5 0 0 1 3 0v7c0 4-3 7-7 7-3 0-5-2-6.5-4L3 13.5a1.6 1.6 0 0 1 2.4-2z" fill="#2a1f16"/>',
  star: '<path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5L2.5 9.4l6.6-.9z" fill="#2a1f16"/>',
  rules: '<path d="M5 3h11l3 3v15H5z" fill="none" stroke="#2a1f16" stroke-width="2.2" stroke-linejoin="round"/><path d="M8 10h8M8 14h8M8 18h5" stroke="#2a1f16" stroke-width="2.2" stroke-linecap="round"/>',
};
---
<span class="pc" style={`background:${bg}`} aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" focusable="false" set:html={paths[icon] ?? paths.star} /></span>
