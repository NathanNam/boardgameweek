---
import { STORE, NOT_SPONSORED } from '../lib/site';
interface Props { localNote?: string }
const { localNote } = Astro.props;
---
<section class="strip" id="local" aria-labelledby="local-h">
  <div class="awning" aria-hidden="true"></div>
  <div class="in">
    <div>
      <p class="label">Our neighborhood game store</p>
      <h2 id="local-h">Play at Dogpatch Games</h2>
      <p class="sub">The game store in our neighborhood, San Francisco's Dogpatch, where we play, learn and buy games.</p>
      {localNote && <p class="weekly">{localNote}</p>}
      <p>Ask them about this week's games, or check their games library before you go. They run Learn + Play on Thursdays and Saturdays, with a new game every week.</p>
      <ul class="btns">
        <li><a class="btn green" href={STORE.directions}>Directions <span aria-hidden="true">↗</span></a></li>
        <li><a class="btn plain" href={STORE.library}>Games library <span aria-hidden="true">↗</span></a></li>
        <li><a class="btn" href={STORE.learnPlay}>Learn + Play · Thu &amp; Sat <span aria-hidden="true">↗</span></a></li>
      </ul>
      <p class="ns">{NOT_SPONSORED}</p>
    </div>
    <div class="sign">
      <p class="label">Dogpatch Games</p>
      <address>{STORE.address}<br>San Francisco</address>
      <dl class="hours">
        {STORE.hours.map((h) => (<><dt>{h.days}</dt><dd>{h.time}</dd></>))}
      </dl>
      <p class="sign-links"><a href={STORE.site}>dogpatch.games <span aria-hidden="true">↗</span></a> · <a href="/local-store/">More about it</a></p>
    </div>
  </div>
</section>
