---
import type { Issue } from '../lib/issues';
type Video = Issue['data']['family']['video'];
interface Props { video: Video; id: string }
const { video, id } = Astro.props;
const watch = `https://www.youtube.com/watch?v=${video.id}`;
---
<div class="vid" id={id}>
  <div class="tv">
    <a class="screen" href={watch} data-yt={video.id} data-title={video.title}>
      <img src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" decoding="async" referrerpolicy="no-referrer">
      <span class="play" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 26 26" focusable="false"><path d="M8 4l15 9-15 9z" fill="#2a1f16"/></svg></span>
      <span class="vh">Play video: {video.title}, by {video.channel}, {video.length}</span>
    </a>
    <div class="knobs">
      <p>{video.title}<br>{video.channel} · {video.length}</p>
      <span class="k" aria-hidden="true"><i></i><i></i></span>
    </div>
  </div>
  <p class="vid-note">{video.note && `${video.note} `}<a href={watch}>Watch on YouTube<span aria-hidden="true"> ↗</span></a></p>
</div>
